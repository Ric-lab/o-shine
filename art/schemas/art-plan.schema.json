{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://o-shine.local/schemas/art-plan.schema.json",
  "title": "O-Shine Art Plan",
  "type": "object",
  "required": [
    "schemaVersion",
    "job",
    "theme",
    "benchmarks",
    "assets",
    "vfx"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "job": {
      "type": "string",
      "minLength": 1
    },
    "theme": {
      "type": "object",
      "required": [
        "name",
        "creativeIntent"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "creativeIntent": {
          "type": "string",
          "minLength": 1
        },
        "shapeLanguage": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "materialIntent": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "paletteIntent": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "benchmarks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "reference",
          "lesson"
        ],
        "properties": {
          "reference": {
            "type": "string"
          },
          "lesson": {
            "type": "string"
          },
          "copyConstraint": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "rationale",
          "production"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "role": {
            "type": "string"
          },
          "tier": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "production": {
            "const": "meshy-image-to-3d-then-blender"
          },
          "views": {
            "type": "array",
            "items": {
              "enum": [
                "front",
                "three-quarter",
                "side",
                "back"
              ]
            }
          },
          "animation": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "vfx": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "trigger",
          "purpose",
          "tier"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "trigger": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "tier": {
            "enum": [
              1,
              2,
              3
            ]
          },
          "format": {
            "enum": [
              "flipbook",
              "sprite-particles",
              "code-transform",
              "not-applicable"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
